# Tool locations for the shared pipeline (copy to .env; .env is git-ignored).
# No data-centre account is needed: stations, picks and waveforms come from FDSN services.
# (PocketQuake's Korean data sources and their credentials are not used.)
EQNET_DIR=/path/to/EQNet                 # PhaseNet+ (EQNet); EQNET_WEIGHTS=/path/to/model_99.pth optional
SKHASH_DIR=/path/to/SKHASH               # focal mechanisms
HELVETICA_DIR=/path/to/helvetica/fonts   # optional, figure font
# optional Python backends
# RELOCDD_PY_DIR=/path/to/relocDD-py
# EIKONET_DIR=/path/to/EikoNet
# HYPOSVI_DIR=/path/to/HypoSVI
